{
  "hosting": {
    "site": "thejago-commerce-panel",
    "public": "out",
    "ignore": ["firebase.dashboard.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      { "source": "/_next/static/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
    ]
  }
}
